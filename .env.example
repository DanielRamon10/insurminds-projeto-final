# Provedor do modelo de linguagem: google | groq | openrouter | anthropic | openai
LLM_PROVIDER=google
LLM_MODEL=gemini-3.6-flash

# Preencha a chave de cada provedor que for usar. Quanto mais provedores
# configurados, mais a cascata aguenta antes de ficar sem cota — uma comparacao
# entre duas apolices custa ~78 mil tokens de entrada.
#
# ESTE ARQUIVO E UM MODELO E NAO DEVE CONTER CHAVE NENHUMA.
# Copie para .env (que esta no .gitignore) e preencha la.
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# OCR: so e necessario se o Tesseract estiver instalado fora do PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
