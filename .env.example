# Provedor do modelo de linguagem: google | anthropic | openai
LLM_PROVIDER=google
LLM_MODEL=gemini-3.6-flash

# Preencha apenas a chave do provedor escolhido.
# Este arquivo e um MODELO: copie para .env e nunca versione o .env.
GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# OCR (preencher se usar servico de nuvem em vez de Tesseract local)
# AZURE_DOCUMENT_INTELLIGENCE_KEY=
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
